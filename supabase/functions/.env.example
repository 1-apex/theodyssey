# Copy to supabase/functions/.env (gitignored). These are Edge Function secrets and must never go in the app bundle.
# Gemini API key
LLM_API_KEY=
# Mapbox access token
GEOCODING_API_KEY=
# Optional Gemini model id override
# LLM_MODEL=
# Optional: override the Gemini API base URL (tests/proxies)
# LLM_BASE_URL=
# Optional: override the Mapbox API base URL (tests/proxies)
# GEOCODING_BASE_URL=
